{
  "name": "claude-code-zh",
  "displayName": "Claude Code for VS Code 繁體／簡體中文語言包",
  "description": "Claude Code for VS Code 中文化擴充功能：繁體中文（台灣）與簡體中文（中國大陸）雙語，可自動偵測系統語言或手動切換，含狀態列快速指令選單。",
  "version": "2.4.3",
  "publisher": "LaiYueJi",
  "license": "MIT",
  "icon": "logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/LaiYueJi/claude-code-zh.git"
  },
  "bugs": {
    "url": "https://github.com/LaiYueJi/claude-code-zh/issues"
  },
  "homepage": "https://github.com/LaiYueJi/claude-code-zh#readme",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Language Packs",
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "sonnet",
    "opus",
    "ai",
    "mcp",
    "agent",
    "chinese",
    "中文",
    "繁體中文",
    "繁體",
    "台灣",
    "正體中文",
    "简体中文",
    "简体",
    "中国",
    "大陆",
    "汉化",
    "zh-TW",
    "zh-CN",
    "i18n",
    "漢化",
    "繁化"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeCodeZh.showMenu",
        "title": "%cmd.showMenu%",
        "category": "Claude Code 中文化"
      },
      {
        "command": "claudeCodeZh.applyTranslation",
        "title": "%cmd.applyTranslation%",
        "category": "Claude Code 中文化"
      },
      {
        "command": "claudeCodeZh.reloadTranslation",
        "title": "%cmd.reloadTranslation%",
        "category": "Claude Code 中文化"
      },
      {
        "command": "claudeCodeZh.reloadClaudeUi",
        "title": "%cmd.reloadClaudeUi%",
        "category": "Claude Code 中文化",
        "icon": "$(globe)",
        "shortTitle": "%cmd.reloadClaudeUi.short%"
      },
      {
        "command": "claudeCodeZh.restoreOriginal",
        "title": "%cmd.restoreOriginal%",
        "category": "Claude Code 中文化"
      },
      {
        "command": "claudeCodeZh.switchLanguage",
        "title": "%cmd.switchLanguage%",
        "category": "Claude Code 中文化"
      },
      {
        "command": "claudeCodeZh.scanUntranslated",
        "title": "%cmd.scanUntranslated%",
        "category": "Claude Code 中文化"
      },
      {
        "command": "claudeCodeZh.viewUntranslatedList",
        "title": "%cmd.viewUntranslatedList%",
        "category": "Claude Code 中文化"
      },
      {
        "command": "claudeCodeZh.gotoUntranslated",
        "title": "%cmd.gotoUntranslated%",
        "category": "Claude Code 中文化"
      },
      {
        "command": "claudeCodeZh.checkUpdate",
        "title": "%cmd.checkUpdate%",
        "category": "Claude Code 中文化"
      },
      {
        "command": "claudeCodeZh.resetTranslationPack",
        "title": "%cmd.resetTranslationPack%",
        "category": "Claude Code 中文化"
      },
      {
        "command": "claudeCodeZh.openCommandPalette",
        "title": "%cmd.openCommandPalette%",
        "category": "Claude Code 中文化"
      },
      {
        "command": "claudeCodeZh.openConfig",
        "title": "%cmd.openConfig%",
        "category": "Claude Code 中文化"
      },
      {
        "command": "claudeCodeZh.showStatus",
        "title": "%cmd.showStatus%",
        "category": "Claude Code 中文化"
      },
      {
        "command": "claudeCodeZh.reloadWindow",
        "title": "%cmd.reloadWindow%",
        "category": "Claude Code 中文化"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeCodeZh.reloadClaudeUi",
          "when": "view == claudeVSCodeSidebar || view == claudeVSCodeSidebarSecondary || view == claudeVSCodeSessionsList",
          "group": "navigation@99"
        }
      ],
      "editor/title": [
        {
          "command": "claudeCodeZh.reloadClaudeUi",
          "when": "activeWebviewPanelId == claudeVSCodePanel",
          "group": "navigation@99"
        }
      ]
    },
    "configuration": {
      "title": "Claude Code 中文化",
      "properties": {
        "claudeCodeZh.language": {
          "type": "string",
          "enum": [
            "auto",
            "zh-TW",
            "zh-CN"
          ],
          "enumDescriptions": [
            "%cfg.language.auto%",
            "%cfg.language.tw%",
            "%cfg.language.cn%"
          ],
          "default": "auto",
          "description": "%cfg.language%"
        },
        "claudeCodeZh.autoApplyOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.autoApplyOnStartup%"
        },
        "claudeCodeZh.autoApplyOnUpdate": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.autoApplyOnUpdate%"
        },
        "claudeCodeZh.autoReloadClaudeUi": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.autoReloadClaudeUi%"
        },
        "claudeCodeZh.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.showStatusBar%"
        },
        "claudeCodeZh.createBackup": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.createBackup%"
        },
        "claudeCodeZh.showNotifications": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.showNotifications%"
        },
        "claudeCodeZh.claudeCodeExtensionId": {
          "type": "string",
          "default": "Anthropic.claude-code",
          "description": "%cfg.claudeCodeExtensionId%"
        },
        "claudeCodeZh.autoUpdateTranslations": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.autoUpdateTranslations%"
        },
        "claudeCodeZh.checkExtensionUpdate": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.checkExtensionUpdate%"
        },
        "claudeCodeZh.translationSourceUrls": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "%cfg.translationSourceUrls%"
        },
        "claudeCodeZh.preTranslationRules": {
          "type": "array",
          "default": [],
          "description": "%cfg.preTranslationRules%",
          "items": {
            "type": "object",
            "properties": {
              "original": {
                "type": "string",
                "description": "%cfg.rules.original%"
              },
              "chinese": {
                "type": "string",
                "description": "%cfg.rules.chinese%"
              },
              "regex": {
                "type": "boolean",
                "default": false,
                "description": "%cfg.rules.regex%"
              },
              "flags": {
                "type": "string",
                "default": "g",
                "description": "%cfg.rules.flags%"
              }
            },
            "required": [
              "original",
              "chinese"
            ]
          }
        },
        "claudeCodeZh.postTranslationRules": {
          "type": "array",
          "default": [],
          "description": "%cfg.postTranslationRules%",
          "items": {
            "type": "object",
            "properties": {
              "original": {
                "type": "string",
                "description": "%cfg.rules.original%"
              },
              "chinese": {
                "type": "string",
                "description": "%cfg.rules.chinese%"
              },
              "regex": {
                "type": "boolean",
                "default": false,
                "description": "%cfg.rules.regex%"
              },
              "flags": {
                "type": "string",
                "default": "g",
                "description": "%cfg.rules.flags%"
              }
            },
            "required": [
              "original",
              "chinese"
            ]
          }
        }
      }
    }
  },
  "scripts": {
    "verify": "node scripts/verify-release.js",
    "build": "npm run verify && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.7.1"
  }
}
